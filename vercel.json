{
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**,ai/**",
      "excludeFiles": "frontend/**,docs/**,scripts/**,venv/**,.venv/**,node_modules/**,.git/**"
    }
  },
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
